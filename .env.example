# Desarrollo local: deja DATABASE_URL vacío para usar database.db (SQLite).
# Producción: usa la cadena de conexión de Supabase, con la contraseña incluida.
DATABASE_URL=

# Usa una contraseña larga y única para acceder al panel administrativo.
ADMIN_PASSWORD=

# Stripe: necesaria para activar el pago real con tarjeta.
STRIPE_SECRET_KEY=